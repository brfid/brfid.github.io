# VAX 11/780 with 4.3BSD and a pexpect-controlled local console.
# Build with the repository root as context. Promote production images through
# build-images.yml; the local runner may build this recipe as a fallback.
FROM jguillaumes/simh-vaxbsd:latest@sha256:1bab805b25a793fd622c29d3e9b677b002cabbdc20d9c42afaeeed542cc42215

RUN apt-get update && apt-get install -y python3 python3-pexpect \
    && rm -rf /var/lib/apt/lists/*

# Cache paths discovered in the base image and expand disks before SIMH starts.
RUN set -e; \
    ini=$(find / -name 'vax780.ini' -not -path '*/proc/*' 2>/dev/null | head -1); \
    if [ -z "$ini" ]; then \
        echo "ERROR: vax780.ini not found in base image" >&2; \
        exit 1; \
    fi; \
    dir=$(dirname "$ini"); \
    echo "Found ini: $ini  (dir: $dir)"; \
    echo "${dir}/vax780-pexpect.ini"    > /opt/vax-pexpect-ini-path.txt; \
    which vax780                        > /opt/vax-bin-path.txt 2>/dev/null || echo "vax780" > /opt/vax-bin-path.txt; \
    echo "Decompressing disk images in $dir"; \
    for gz in "$dir"/*.gz; do \
        [ -f "$gz" ] && gunzip "$gz" && echo "  decompressed: $gz"; \
    done; \
    echo "Cached paths:"; \
    cat /opt/vax-pexpect-ini-path.txt /opt/vax-bin-path.txt; \
    echo "Disk images:"; \
    ls -lh "$dir"/RA81* 2>/dev/null || true

COPY vintage/machines/vax/configs/vax780-pexpect.ini /image/vax780-pexpect.ini

COPY scripts/vax_pexpect.py /opt/vax_pexpect.py
COPY scripts/simh_session.py /opt/simh_session.py

ENTRYPOINT ["python3", "/opt/vax_pexpect.py"]
