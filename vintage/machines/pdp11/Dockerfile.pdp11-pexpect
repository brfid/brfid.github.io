# PDP-11/73 with 2.11BSD and a pexpect-controlled local console.
# Build with the repository root as context. Promote production images through
# the GitHub image-build workflow; the local runner may build this recipe as a fallback.
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS simh-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libedit-dev \
    libpcre3-dev \
    wget \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# Pin the SIMH source revision used to build the PDP-11 emulator.
WORKDIR /tmp
RUN git clone https://github.com/simh/simh.git && \
    cd simh && \
    git checkout 627e6a6b135261f9dcb46dc1a8665c7fe67d3f7c && \
    printf 'n\n' | make pdp11 && \
    cp BIN/pdp11 /usr/local/bin/ && \
    cd .. && \
    rm -rf simh

# The disk archive contains both kernels; the script selects the default `unix` kernel.
WORKDIR /opt/pdp11
RUN wget --inet4-only --timeout=60 --tries=3 --progress=dot:giga \
      https://github.com/brfid/brfid.github.io/releases/download/211bsd-rpethset-2019-05-30/211bsd_rpethset.tgz && \
    printf '%s  %s\n' \
      '74678c649338b10bfc470b4fec4bd75b649b4df1e3eb5a9f227ed7ac7d947b42' \
      '211bsd_rpethset.tgz' | sha256sum -c - && \
    tar xzf 211bsd_rpethset.tgz && \
    chmod 644 211bsd_rpeth.dsk && \
    rm -f 211bsd_rpethset.tgz *.txt *.pdf

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libedit2 \
    libpcre3 \
    python3 \
    python3-pexpect \
    && rm -rf /var/lib/apt/lists/*

COPY --from=simh-builder /usr/local/bin/pdp11 /usr/local/bin/pdp11

RUN set -eu; \
    pdp11 RegisterSanityCheck </dev/null > /tmp/pdp11-smoke.log 2>&1; \
    grep -Fq 'Good Registers in PDP-11 simulator.' /tmp/pdp11-smoke.log; \
    rm /tmp/pdp11-smoke.log; \
    python3 -c 'import pexpect'; \
    ! command -v cc; \
    ! command -v git; \
    ! command -v make; \
    ! command -v wget; \
    test ! -e /usr/include/editline/readline.h; \
    test ! -e /usr/include/pcre.h

COPY --from=simh-builder /opt/pdp11/211bsd_rpeth.dsk /opt/pdp11/211bsd_rpeth.dsk

COPY vintage/machines/pdp11/configs/pdp11-pexpect.ini /opt/pdp11/pdp11-pexpect.ini
COPY scripts/pdp11_pexpect.py /opt/pdp11/pdp11_pexpect.py
COPY scripts/simh_session.py /opt/pdp11/simh_session.py

WORKDIR /opt/pdp11

ENTRYPOINT ["python3", "/opt/pdp11/pdp11_pexpect.py", \
            "--ini", "/opt/pdp11/pdp11-pexpect.ini", \
            "--workdir", "/opt/pdp11"]
