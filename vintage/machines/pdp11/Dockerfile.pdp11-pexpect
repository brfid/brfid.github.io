# PDP-11/73 with 2.11BSD and a pexpect-controlled local console.
# Build with the repository root as context. Promote production images through
# build-images.yml; the local runner may build this recipe as a fallback.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    libedit-dev \
    libpcre3-dev \
    wget \
    ca-certificates \
    git \
    python3 \
    python3-pexpect \
    && rm -rf /var/lib/apt/lists/*

# Pin the SIMH source revision used to build the PDP-11 emulator.
WORKDIR /tmp
RUN git clone https://github.com/simh/simh.git && \
    cd simh && \
    git checkout 627e6a6b135261f9dcb46dc1a8665c7fe67d3f7c && \
    printf 'n\n' | make pdp11 && \
    cp BIN/pdp11 /usr/local/bin/ && \
    cd .. && \
    rm -rf simh

# The disk archive contains both kernels; the script selects the default `unix` kernel.
WORKDIR /opt/pdp11
RUN wget -q https://www.retro11.de/data/oc_w11/oskits/211bsd_rpethset.tgz && \
    tar xzf 211bsd_rpethset.tgz && \
    chmod 644 211bsd_rpeth.dsk && \
    rm -f 211bsd_rpethset.tgz *.txt *.pdf

COPY vintage/machines/pdp11/configs/pdp11-pexpect.ini /opt/pdp11/pdp11-pexpect.ini
COPY scripts/pdp11_pexpect.py /opt/pdp11/pdp11_pexpect.py
COPY scripts/simh_session.py /opt/pdp11/simh_session.py

WORKDIR /opt/pdp11

ENTRYPOINT ["python3", "/opt/pdp11/pdp11_pexpect.py", \
            "--ini", "/opt/pdp11/pdp11-pexpect.ini", \
            "--workdir", "/opt/pdp11"]
